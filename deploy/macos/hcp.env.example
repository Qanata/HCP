# HCP server configuration (Rust). Copy to ~/.config/hcp/hcp.env and fill in.
# This file holds secrets: keep it readable only by you (chmod 600).

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. The existing Neon database works as-is; use
# sslmode=verify-full so the server certificate is actually checked.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/hcp?sslmode=verify-full"

# ── Obsidian vault (required) ───────────────────────────────────────────────
# The vault folder itself (the one containing .obsidian). Logs go under HCP/ inside it.
HCP_OBSIDIAN_VAULT="~/Obsidian/Main"
# HCP_OBSIDIAN_FOLDER=HCP

# ── Slack ───────────────────────────────────────────────────────────────────
# Bot token (xoxb-…) with the chat:write scope.
SLACK_BOT_TOKEN=
# App-level token (xapp-…) with connections:write. Enables Socket Mode: Slack interactions
# arrive over an outbound WebSocket, so this machine needs no public URL.
SLACK_APP_TOKEN=
# Channel ID (not name) that receives every request needing a human. Invite the bot to it.
HCP_SLACK_CHANNEL=
# Optional: channel for one-way notifications. Unset = notifications are only logged.
# HCP_SLACK_NOTIFY_CHANNEL=
# Optional: responder_id=SlackUserID pairs. A mapped responder is @-mentioned and is the
# only person whose clicks count for requests addressed to them.
# HCP_SLACK_RESPONDERS=isaac=U0123ABCD,ops-lead=U0456EFGH
# Alternative to Socket Mode, if this server has a public HTTPS URL: set the signing
# secret and point Slack's Interactivity Request URL at https://<host>/slack/interactions.
# SLACK_SIGNING_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
# Loopback by default. Set to 0.0.0.0 only if agents on other machines must reach it.
# HCP_BIND=127.0.0.1
# HCP_PORT=3100
# Console verbosity (tracing filter syntax). The vault keeps HCP's own INFO-and-above lines.
# HCP_LOG=info,sqlx=warn
